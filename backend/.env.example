DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nexora
DB_USER=nexora_app
DB_PASSWORD=replace_with_secret_from_deployment_environment
DB_SSL_MODE=verify-full
DB_SSL_ROOT_CERT=/etc/nexora/certs/postgresql-ca.pem
APP_ENV=production
SESSION_COOKIE_NAME=nexora_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=24
TRUST_PROXY_HEADERS=true
